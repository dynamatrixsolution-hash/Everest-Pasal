// ==============================================================================
// EVEREST PASAL - COMPLETE PRODUCTION DATABASE ARCHITECTURE (PRISMA SCHEMA)
// Author: Senior Backend Engineer & Database Architect
// Specification: Everest Pasal System Architecture & Specification (v1.2)
// Tables: 38 | Domains: 14 | Enums: 22
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 01. IDENTITY & ACCESS CONTROL DOMAIN (ENT-001, ENT-003, ENT-004, ENT-009)
// Tables: Account, RoleAssignment, DelegationConsent, Address
// ==============================================================================

model Account {
  id                   String                      @id @default(uuid())
  email                String?                     @unique
  phone                String?                     @unique
  passwordHash         String?
  fullName             String
  status               AccountStatus               @default(ACTIVE)
  emailVerified        Boolean                     @default(false)
  phoneVerified        Boolean                     @default(false)
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  roles                RoleAssignment[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  otpRecords           OtpRecord[]
  accountIdentities    AccountIdentity[]
  authEvents           AuthenticationEvent[]
  grantedConsents      DelegationConsent[]         @relation("GranterAccount")
  receivedConsents     DelegationConsent[]         @relation("GranteeAccount")
  addresses            Address[]
  baskets              Basket[]
  orders               Order[]
  supportCases         SupportCase[]
  supportMessages      SupportCaseMessage[]
  notifications        Notification[]
  purchaseAttempts     PurchaseAttempt[]
  cancellationRequests CancellationReturnRequest[]
  orderStatusChanges   OrderStatusHistory[]
  auditEvents          AuditEvent[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
  @@map("tb_ep_auth_AccountMaster")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Session {
  id         String    @id @default(uuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@index([tokenHash])
  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("tb_ep_admin_Log_SessionMaster")
}

model VerificationToken {
  id        String              @id @default(uuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@unique([accountId, purpose, tokenHash])
  @@index([accountId, purpose])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("tb_ep_auth_Token_VerificationMaster")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("tb_ep_auth_Token_PasswordResetMaster")
}

model OtpRecord {
  id           String     @id @default(uuid())
  accountId    String?
  account      Account?   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  destination  String
  purpose      OtpPurpose
  otpHash      String
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(5)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("tb_ep_auth_Log_OtpRecordMaster")
}

enum OtpPurpose {
  PHONE_LOGIN
  PHONE_VERIFICATION
  EMAIL_LOGIN
  TWO_FACTOR
}

model AccountIdentity {
  id                String       @id @default(uuid())
  accountId         String
  account           Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  accessTokenHash   String?
  refreshTokenHash  String?
  tokenExpiresAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([accountId])
  @@index([provider])
  @@map("tb_ep_auth_IdentityMaster")
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
  GITHUB
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  domain      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([domain])
  @@index([code])
  @@map("tb_ep_admin_Acl_PermissionMaster")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("tb_ep_admin_Acl_RolePermissionMap")
}

model AuthenticationEvent {
  id         String        @id @default(uuid())
  accountId  String?
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  eventType  AuthEventType
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  occurredAt DateTime      @default(now())

  @@index([accountId])
  @@index([eventType])
  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@map("tb_ep_admin_Log_AuthEventMaster")
}

enum AuthEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  SESSION_REVOKED
  ROLE_ASSIGNED
  ROLE_REVOKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  OAUTH_LINKED
}

model RoleAssignment {
  id             String        @id @default(uuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role           UserRole
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status         RoleStatus    @default(ACTIVE)
  assignedAt     DateTime      @default(now())

  @@unique([accountId, role, organizationId])
  @@index([accountId])
  @@index([organizationId])
  @@index([role])
  @@map("tb_ep_admin_Acl_RoleAssignmentMaster")
}

enum UserRole {
  CUSTOMER
  VENDOR_ADMIN
  VENDOR_STAFF
  PLATFORM_ADMIN
  FINANCE_ADMIN
  SUPPORT_AGENT
}

enum RoleStatus {
  ACTIVE
  REVOKED
}

model DelegationConsent {
  id               String        @id @default(uuid())
  granterAccountId String
  granter          Account       @relation("GranterAccount", fields: [granterAccountId], references: [id], onDelete: Cascade)
  granteeAccountId String
  grantee          Account       @relation("GranteeAccount", fields: [granteeAccountId], references: [id], onDelete: Cascade)
  scope            String
  status           ConsentStatus @default(ACTIVE)
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([granterAccountId])
  @@index([granteeAccountId])
  @@index([status])
  @@map("tb_ep_auth_Consent_DelegationMaster")
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Address {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  province     String
  postalCode   String?
  country      String   @default("NP")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Usage references
  orders Order[]

  @@index([accountId])
  @@index([accountId, isDefault])
  @@map("tb_ep_customer_AddressMaster")
}

// ==============================================================================
// 02. ORGANIZATION & VENDOR DOMAIN (ENT-002, ENT-010)
// Tables: Organization, VendorProfile
// ==============================================================================

model Organization {
  id             String    @id @default(uuid())
  legalName      String
  tradeName      String?
  registrationNo String?   @unique
  taxId          String?   @unique
  status         OrgStatus @default(PENDING_VERIFICATION)
  country        String    @default("NP")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  vendorProfile    VendorProfile?
  roleAssignments  RoleAssignment[]
  offers           Offer[]
  fulfillmentUnits VendorFulfillmentUnit[]
  entitlements     EntitlementAdjustment[]
  statements       StatementPayout[]
  supportCases     SupportCase[]
  campaigns        Campaign[]

  @@index([status])
  @@index([taxId])
  @@map("tb_ep_vendor_OrganizationMaster")
}

enum OrgStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

model VendorProfile {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName         String
  logoUrl             String?
  bannerUrl           String?
  description         String?
  commissionRatePct   Decimal      @default(10.00) @db.Decimal(5, 2)
  settlementCycleDays Int          @default(14)
  returnWindowDays    Int          @default(7)
  isVerified          Boolean      @default(false)
  rating              Decimal?     @db.Decimal(3, 2)
  totalSales          Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([isVerified])
  @@map("tb_ep_vendor_ProfileMaster")
}

// ==============================================================================
// 03. PRODUCT CATALOG DOMAIN (ENT-005, ENT-006)
// Tables: Category, ProductCategory, Product, ProductMedia, ProductAttribute, ProductVariant, Offer
// ==============================================================================

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  productCategories ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("tb_ep_catalog_CategoryMaster")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("tb_ep_catalog_ProductCategoryMap")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  brand       String?
  barcode     String?       @unique
  status      ProductStatus @default(DRAFT)
  tags        String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories ProductCategory[]
  media      ProductMedia[]
  attributes ProductAttribute[]
  variants   ProductVariant[]
  offers     Offer[]

  @@index([slug])
  @@index([status])
  @@index([brand])
  @@map("tb_ep_catalog_ProductMaster")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("tb_ep_catalog_MediaMaster")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@unique([productId, name])
  @@index([productId])
  @@map("tb_ep_catalog_AttributeMaster")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  attributes Json     @default("{}")
  createdAt  DateTime @default(now())

  offers Offer[]

  @@index([productId])
  @@map("tb_ep_catalog_VariantMaster")
}

model Offer {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku               String          @unique
  title             String
  price             Decimal         @db.Decimal(12, 2)
  compareAtPrice    Decimal?        @db.Decimal(12, 2)
  currency          String          @default("NPR")
  status            OfferStatus     @default(DRAFT)
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(5)
  weight            Decimal?        @db.Decimal(8, 3)
  dimensions        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inventoryPositions InventoryPosition[]
  basketItems        BasketItem[]
  orderItems         OrderItem[]
  campaignAttrib     CampaignAttribution[]

  @@index([organizationId])
  @@index([productId])
  @@index([sku])
  @@index([status])
  @@index([organizationId, status])
  @@map("tb_ep_catalog_OfferMaster")
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  DISCONTINUED
}

// ==============================================================================
// 04. INVENTORY & LEDGER DOMAIN (ENT-007)
// Tables: InventoryPosition, InventoryMovement
// ==============================================================================

model InventoryPosition {
  id                String   @id @default(uuid())
  offerId           String   @unique
  offer             Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0) // Computed: onHand - reserved
  warehouseCode     String?  @default("DEFAULT")
  updatedAt         DateTime @updatedAt

  movements InventoryMovement[]

  @@index([offerId])
  @@index([quantityAvailable])
  @@map("tb_ep_inventory_StockPositionMaster")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  positionId      String
  position        InventoryPosition     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  movementType    InventoryMovementType
  quantityDelta   Int // +ve = increase, -ve = decrease
  quantityBefore  Int
  quantityAfter   Int
  referenceType   String? // "ORDER", "RETURN", "ADJUSTMENT", "RECEIPT"
  referenceId     String?
  reason          String?
  createdAt       DateTime              @default(now())
  createdBySystem Boolean               @default(false)

  @@index([positionId])
  @@index([positionId, createdAt])
  @@index([referenceType, referenceId])
  @@map("tb_ep_inventory_Log_StockMovementMaster")
}

enum InventoryMovementType {
  RECEIPT // Stock received from supplier
  SALE_RESERVE // Reserved for a customer order
  SALE_COMMIT // Confirmed as shipped
  SALE_RELEASE // Released reservation (cancelled before ship)
  RETURN_RECEIPT // Stock returned by customer
  ADJUSTMENT_IN // Manual positive adjustment
  ADJUSTMENT_OUT // Manual negative adjustment
  WRITE_OFF // Damaged / loss
}

// ==============================================================================
// 05. CUSTOMER BASKET DOMAIN (ENT-008)
// Tables: Basket, BasketItem
// ==============================================================================

model Basket {
  id        String       @id @default(uuid())
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status    BasketStatus @default(ACTIVE)
  currency  String       @default("NPR")
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items BasketItem[]

  @@index([accountId])
  @@index([accountId, status])
  @@map("tb_ep_customer_BasketMaster")
}

enum BasketStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

model BasketItem {
  id        String   @id @default(uuid())
  basketId  String
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2) // Snapshot at time of add
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([basketId, offerId])
  @@index([basketId])
  @@index([offerId])
  @@map("tb_ep_customer_BasketItemDetail")
}

// ==============================================================================
// 06. CHECKOUT & ORDER DOMAIN (ENT-011, ENT-012, ENT-013)
// Tables: PurchaseAttempt, Order, OrderItem, OrderStatusHistory
// ==============================================================================

model PurchaseAttempt {
  id             String        @id @default(uuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  idempotencyKey String        @unique // Client-generated; prevents duplicate orders
  status         AttemptStatus @default(PENDING)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("NPR")
  failureReason  String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  order           Order?
  paymentAttempts PaymentAttempt[]

  @@index([accountId])
  @@index([idempotencyKey])
  @@index([status])
  @@map("tb_ep_order_PurchaseAttemptMaster")
}

enum AttemptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model Order {
  id                String          @id @default(uuid())
  purchaseAttemptId String          @unique
  purchaseAttempt   PurchaseAttempt @relation(fields: [purchaseAttemptId], references: [id], onDelete: Restrict)
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  addressId         String?
  address           Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  orderNumber       String          @unique // Human-readable: EP-YYYYMMDD-XXXXXX
  status            OrderStatus     @default(PENDING_PAYMENT)
  subtotal          Decimal         @db.Decimal(12, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(12, 2)
  shippingAmount    Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal         @db.Decimal(12, 2)
  currency          String          @default("NPR")
  notes             String?
  metadata          Json?
  placedAt          DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  fulfillmentUnits     VendorFulfillmentUnit[]
  cancellationRequests CancellationReturnRequest[]
  campaignAttrib       CampaignAttribution[]

  @@index([accountId])
  @@index([orderNumber])
  @@index([status])
  @@index([accountId, placedAt])
  @@map("tb_ep_order_OrderMaster")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  DISPUTED
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offerId        String
  offer          Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  // Commercial snapshot — immutable after order placement
  sku            String
  productName    String
  variantName    String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("NPR")

  fulfillmentItems VendorFulfillmentItem[]

  @@index([orderId])
  @@index([offerId])
  @@index([orderId, offerId])
  @@map("tb_ep_order_OrderItemDetail")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   Account?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  metadata    Json?
  changedAt   DateTime     @default(now())

  @@index([orderId])
  @@index([orderId, changedAt])
  @@map("tb_ep_order_Log_StatusHistoryMaster")
}

// ==============================================================================
// 07. PAYMENTS & CALLBACKS DOMAIN (ENT-014, ENT-015)
// Tables: PaymentAttempt, PaymentEvent
// ==============================================================================

model PaymentAttempt {
  id                String          @id @default(uuid())
  purchaseAttemptId String
  purchaseAttempt   PurchaseAttempt @relation(fields: [purchaseAttemptId], references: [id], onDelete: Restrict)
  gateway           String // "ESEWA", "KHALTI", "CONNECTIPS", "CARD", "COD"
  gatewayTxnRef     String? // Gateway's transaction reference
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("NPR")
  status            PaymentStatus   @default(INITIATED)
  initiatedAt       DateTime        @default(now())
  confirmedAt       DateTime?
  failureReason     String?
  gatewayResponse   Json?

  events  PaymentEvent[]
  refunds Refund[]

  @@index([purchaseAttemptId])
  @@index([gatewayTxnRef])
  @@index([status])
  @@index([gateway, status])
  @@map("tb_ep_payment_PaymentAttemptMaster")
}

enum PaymentStatus {
  INITIATED
  PENDING_REDIRECT
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
  REVERSED
}

model PaymentEvent {
  id               String         @id @default(uuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  eventType        String // "INITIATED", "WEBHOOK_RECEIVED", "CONFIRMED", "FAILED", "REFUNDED"
  eventReference   String         @unique // Gateway-unique event ID; prevents duplicate webhook processing
  payload          Json
  processedAt      DateTime       @default(now())

  @@index([paymentAttemptId])
  @@index([eventReference])
  @@index([paymentAttemptId, processedAt])
  @@map("tb_ep_payment_Log_WebhookEventMaster")
}

// ==============================================================================
// 08. FULFILLMENT & LOGISTICS DOMAIN (ENT-016, ENT-017)
// Tables: VendorFulfillmentUnit, VendorFulfillmentItem, Shipment, DeliveryEvent
// ==============================================================================

model VendorFulfillmentUnit {
  id             String                @id @default(uuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status         FulfillmentUnitStatus @default(AWAITING_CONFIRMATION)
  handledAt      DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items     VendorFulfillmentItem[]
  shipments Shipment[]

  @@index([orderId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("tb_ep_fulfillment_UnitMaster")
}

enum FulfillmentUnitStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

model VendorFulfillmentItem {
  id                String                @id @default(uuid())
  fulfillmentUnitId String
  fulfillmentUnit   VendorFulfillmentUnit @relation(fields: [fulfillmentUnitId], references: [id], onDelete: Restrict)
  orderItemId       String
  orderItem         OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity          Int

  @@unique([fulfillmentUnitId, orderItemId])
  @@index([fulfillmentUnitId])
  @@index([orderItemId])
  @@map("tb_ep_fulfillment_ItemDetail")
}

model Shipment {
  id                String                @id @default(uuid())
  fulfillmentUnitId String
  fulfillmentUnit   VendorFulfillmentUnit @relation(fields: [fulfillmentUnitId], references: [id], onDelete: Restrict)
  carrier           String?
  trackingNumber    String?               @unique
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  status            ShipmentStatus        @default(LABEL_CREATED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  deliveryEvents DeliveryEvent[]

  @@index([fulfillmentUnitId])
  @@index([trackingNumber])
  @@index([status])
  @@map("tb_ep_fulfillment_ShipmentMaster")
}

enum ShipmentStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
}

model DeliveryEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  eventType   String
  location    String?
  description String?
  occurredAt  DateTime @default(now())
  rawPayload  Json?

  @@index([shipmentId])
  @@index([shipmentId, occurredAt])
  @@map("tb_ep_fulfillment_Log_DeliveryEventMaster")
}

// ==============================================================================
// 09. RETURNS & REFUNDS DOMAIN (ENT-018, ENT-019)
// Tables: CancellationReturnRequest, CancellationReturnItem, Refund
// ==============================================================================

model CancellationReturnRequest {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedById String
  requestedBy   Account       @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  requestType   RequestType
  reason        String
  status        RequestStatus @default(SUBMITTED)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items   CancellationReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("tb_ep_refund_RequestMaster")
}

enum RequestType {
  CANCELLATION
  RETURN
  EXCHANGE
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  WITHDRAWN
}

model CancellationReturnItem {
  id        String                    @id @default(uuid())
  requestId String
  request   CancellationReturnRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerId   String
  sku       String
  quantity  Int
  reason    String?

  @@index([requestId])
  @@map("tb_ep_refund_ItemDetail")
}

model Refund {
  id               String                     @id @default(uuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt             @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  requestId        String?
  request          CancellationReturnRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  amount           Decimal                    @db.Decimal(12, 2)
  currency         String                     @default("NPR")
  reason           String?
  status           RefundStatus               @default(PENDING)
  gatewayRefundRef String?
  initiatedAt      DateTime                   @default(now())
  processedAt      DateTime?
  failureReason    String?

  @@index([paymentAttemptId])
  @@index([requestId])
  @@index([status])
  @@map("tb_ep_refund_RefundMaster")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

// ==============================================================================
// 10. CAMPAIGN & ATTRIBUTION DOMAIN (ENT-020)
// Tables: Campaign, CampaignAttribution
// ==============================================================================

model Campaign {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  campaignType   String // "DISCOUNT", "FLASH_SALE", "VOUCHER", "REFERRAL"
  discountType   String? // "PERCENTAGE", "FIXED"
  discountValue  Decimal?      @db.Decimal(12, 2)
  code           String?       @unique
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean       @default(true)
  usageLimit     Int?
  usageCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attributions CampaignAttribution[]

  @@index([code])
  @@index([isActive])
  @@index([organizationId])
  @@map("tb_ep_campaign_CampaignMaster")
}

model CampaignAttribution {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offerId         String?
  offer           Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  discountApplied Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@unique([campaignId, orderId])
  @@index([campaignId])
  @@index([orderId])
  @@map("tb_ep_campaign_AttributionMap")
}

// ==============================================================================
// 11. SETTLEMENT & PAYOUT DOMAIN (ENT-021, ENT-022)
// Tables: EntitlementAdjustment, StatementPayout, SettlementStatementItem, PayoutTransaction
// ==============================================================================

model EntitlementAdjustment {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  adjustmentType AdjustmentType
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @default("NPR")
  referenceType  String? // "ORDER_ITEM", "REFUND", "COMMISSION", "CHARGEBACK", "MANUAL"
  referenceId    String?
  description    String?
  periodStart    DateTime?
  periodEnd      DateTime?
  isSettled      Boolean          @default(false)
  statementId    String?
  statement      StatementPayout? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([organizationId, isSettled])
  @@index([referenceType, referenceId])
  @@index([statementId])
  @@map("tb_ep_payout_AdjustmentMaster")
}

enum AdjustmentType {
  EARNING // Vendor revenue from a sale
  COMMISSION_DEBIT // Platform commission deducted
  REFUND_DEBIT // Amount clawed back due to customer refund
  CHARGEBACK_DEBIT // Chargeback from payment gateway
  MANUAL_CREDIT // Platform-initiated credit
  MANUAL_DEBIT // Platform-initiated debit
}

model StatementPayout {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batchNumber      String       @unique
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal      @db.Decimal(12, 2)
  refundDeductions Decimal      @default(0) @db.Decimal(12, 2)
  chargebacks      Decimal      @default(0) @db.Decimal(12, 2)
  netAmount        Decimal      @db.Decimal(12, 2)
  currency         String       @default("NPR")
  status           PayoutStatus @default(DRAFT)
  approvedAt       DateTime?
  disbursedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  lineItems         SettlementStatementItem[]
  entitlements      EntitlementAdjustment[]
  payoutTransaction PayoutTransaction?

  @@index([organizationId])
  @@index([batchNumber])
  @@index([status])
  @@index([organizationId, status])
  @@map("tb_ep_payout_StatementMaster")
}

enum PayoutStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  DISBURSED
  DISPUTED
  CANCELLED
}

model SettlementStatementItem {
  id          String          @id @default(uuid())
  statementId String
  statement   StatementPayout @relation(fields: [statementId], references: [id], onDelete: Restrict)
  lineType    String // "EARNING", "COMMISSION", "REFUND_DEBIT", "CHARGEBACK"
  referenceId String?
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("NPR")
  description String?
  periodDate  DateTime

  @@index([statementId])
  @@index([statementId, lineType])
  @@map("tb_ep_payout_StatementItemDetail")
}

model PayoutTransaction {
  id             String          @id @default(uuid())
  statementId    String          @unique
  statement      StatementPayout @relation(fields: [statementId], references: [id], onDelete: Restrict)
  bankAccount    String?
  bankCode       String?
  transactionRef String?         @unique
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("NPR")
  status         PayoutStatus    @default(DRAFT)
  initiatedAt    DateTime        @default(now())
  completedAt    DateTime?
  failureReason  String?

  @@index([statementId])
  @@index([transactionRef])
  @@map("tb_ep_payout_TransactionMaster")
}

// ==============================================================================
// 12. SUPPORT & DISPUTES DOMAIN (ENT-023)
// Tables: SupportCase, SupportCaseMessage
// ==============================================================================

model SupportCase {
  id               String        @id @default(uuid())
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subject          String
  category         String // "ORDER", "PAYMENT", "PRODUCT", "DELIVERY", "ACCOUNT", "OTHER"
  priority         CasePriority  @default(MEDIUM)
  status           CaseStatus    @default(OPEN)
  assignedToId     String?
  referenceOrderId String?
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  messages SupportCaseMessage[]

  @@index([accountId])
  @@index([organizationId])
  @@index([status])
  @@index([priority, status])
  @@map("tb_ep_support_CaseMaster")
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_VENDOR
  RESOLVED
  CLOSED
}

model SupportCaseMessage {
  id          String      @id @default(uuid())
  caseId      String
  case        SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId    String
  author      Account     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  isInternal  Boolean     @default(false)
  attachments String[]
  sentAt      DateTime    @default(now())

  @@index([caseId])
  @@index([caseId, sentAt])
  @@map("tb_ep_support_CaseMessageDetail")
}

// ==============================================================================
// 13. NOTIFICATIONS DOMAIN (ENT-023)
// Table: Notification
// ==============================================================================

model Notification {
  id          String              @id @default(uuid())
  accountId   String
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  referenceId String?
  isRead      Boolean             @default(false)
  readAt      DateTime?
  sentAt      DateTime            @default(now())

  @@index([accountId])
  @@index([accountId, isRead])
  @@index([accountId, sentAt])
  @@map("tb_ep_notify_NotificationMaster")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ==============================================================================
// 14. GOVERNANCE & AUDIT DOMAIN (ENT-022)
// Tables: AuditEvent, ConfigurationVersion
// ==============================================================================

model AuditEvent {
  id         String   @id @default(uuid())
  eventType  String
  entityType String?
  entityId   String?
  actorId    String?
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType  String? // "SYSTEM", "ACCOUNT", "GATEWAY_WEBHOOK", "CRON"
  ipAddress  String?
  userAgent  String?
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@map("tb_ep_admin_Log_AuditEventMaster")
}

model ConfigurationVersion {
  id          String   @id @default(uuid())
  key         String
  value       Json
  environment String   @default("production")
  version     Int      @default(1)
  description String?
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  publishedBy String?

  @@unique([key, version, environment])
  @@index([key, environment, isActive])
  @@map("tb_ep_admin_Config_VersionMaster")
}
