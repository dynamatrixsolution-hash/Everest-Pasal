{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://everest-pasal-backend.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://everest-pasal-backend.onrender.com/auth/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://everest-pasal-backend.onrender.com/health/$1"
    },
    {
      "source": "/health",
      "destination": "https://everest-pasal-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
