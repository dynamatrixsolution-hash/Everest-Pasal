        {
          "name": "Login (Auto-Saves JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.data && response.data.session && response.data.session.token) {",
                  "    pm.collectionVariables.set('token', response.data.session.token);",
                  "    console.log('\u2705 Token saved to Collection Variable:', response.data.session.token);",
                  "} else if (response && response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "    console.log('\u2705 Token saved to Collection Variable:', response.data.token);",
                  "}"
                ]
