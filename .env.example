# ==============================================================================
# EVEREST PASAL - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/everest_pasal?schema=public"

# Dedicated Restore Test Database (Used for non-destructive restore verification)
RESTORE_TEST_DATABASE_URL="postgresql://user:password@localhost:5432/everest_pasal_restore_test?schema=public"

# Database Backup Configuration
DB_BACKUP_DIR="./backups/database"
DB_BACKUP_RETENTION_DAYS=7
DB_BACKUP_ENABLED=true

# Optional: PostgreSQL binary directory if pg_dump/pg_restore are not in PATH
# e.g., Windows: PG_BIN_PATH="C:\\Program Files\\PostgreSQL\\18\\bin"
# e.g., Linux/Docker: PG_BIN_PATH="/usr/bin"
PG_BIN_PATH=""

# Server Configuration
PORT=4000
NODE_ENV=development
